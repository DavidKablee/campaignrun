{
  "name": "@cr/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:pg --external:hono --external:hono/* --external:@hono/node-server --outfile=dist/server.js && cp src/schema.sql dist/schema.sql",
    "start": "node dist/server.js",
    "dev": "pnpm build && node --watch dist/server.js",
    "migrate": "node dist/server.js --migrate-only",
    "report": "node --experimental-strip-types src/report.ts"
  },
  "dependencies": {
    "@cr/content": "workspace:*",
    "@cr/sim": "workspace:*",
    "@hono/node-server": "^1.13.8",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "esbuild": "^0.28.2"
  }
}
