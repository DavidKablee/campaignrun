# Copy to .env (gitignored). Read by `pnpm --filter @cr/api dev`.
DATABASE_URL=postgres://YOUR_USER@localhost/campaignrun?host=/tmp
PORT=8787
CR_MIN_PLAYERS=1
CR_ALLOWED_ORIGINS=http://localhost:5173
# Mail (Resend). With no key the verification and reset links print in the API log instead.
# Until you verify a domain in Resend, mail only reaches the address your Resend account was made with.
RESEND_API_KEY=
CR_MAIL_FROM=Campaigner <onboarding@resend.dev>
CR_APP_URL=http://localhost:5173
